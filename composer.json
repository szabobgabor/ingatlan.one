{
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "nyholm/psr7": "^1.5",
    "nyholm/psr7-server": "^1.0",
    "doctrine/dbal": "@stable",
    "php-di/php-di": "@stable",
    "psr/http-server-handler": "@stable",
    "psr/http-server-middleware": "@stable",
    "laminas/laminas-httphandlerrunner": "^2.13",
    "league/commonmark": "^2.8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "friendsofphp/php-cs-fixer": "^3.15",
    "selective/test-traits": "^4.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}